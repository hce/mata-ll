-- Local-spill scoping past Lua's local limit (Q63). Each shape needs
-- >180 locals in one emitted function so bindings spill into the _v
-- table:
-- 1. a guard CONDITION referencing a spilled where-binding (the guard
--    sub-generator must resolve the spill slot, not the bare name);
-- 2. a recursive where-function whose spilled per-invocation locals
--    must live in its OWN spill table — spilling into the enclosing
--    function's table lets the recursive call clobber its caller's
--    argument slot (read after the call returns);
-- 3. an expression-position let group past the budget must spill (its
--    bulk forward declaration used to bypass the counter and emit
--    invalid Lua: "too many local variables").
f :: Int -> Int
f n | big > 0 = big
    | otherwise = 0
  where
    x1 = n + 1
    x2 = x1 + 1
    x3 = x2 + 1
