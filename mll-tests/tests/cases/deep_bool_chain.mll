main :: IO ()
main = do
    print (allBelow 0, allBelow 100, allBelow 199, allBelow 200)
    print (anyAbove 0, anyAbove 100, anyAbove 199, anyAbove 200)
    print (guarded 150, guarded 5, guardedOr 50, guardedOr 199)
    print (withCalls 0, withCalls 120, withCalls 200)
    assert (allBelow 0 && not (allBelow 5)) "and chain"
    assert (anyAbove 100 && not (anyAbove 0)) "or chain"
