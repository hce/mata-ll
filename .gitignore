target/
examples/*.lua
# experiments/ carries the same compiled-Lua and tracker-audio artifacts as
# examples/ used to; ignore them in every subdirectory. Hand-written .lua
# harnesses that are already tracked are unaffected by these rules.
experiments/*.lua
experiments/**/*.lua
# Copyrighted tracker modules must never be committed — and neither may audio
# rendered from them, so .wav/.raw are ignored everywhere too. benchmark.it is
# our own non-copyrighted test fixture, so it is explicitly re-allowed below.
# CI enforces this: the test job fails if any such file is ever tracked.
*.it
*.umx
*.mod
*.xm
*.s3m
*.wav
*.raw
!mll-tests/tests/benchmark.it
lib/*.lua
mllc/lib/*.lua
# Proprietary commercial test code — must never be committed to this public repo.
proprietary-tests/
# Built PDFs are products, not source — never tracked (any doc subdirectory).
doc/**/*.pdf
# LaTeX build intermediates (any doc subdirectory: books/, slides/, ...)
doc/**/*.aux
doc/**/*.log
doc/**/*.out
doc/**/*.toc
doc/**/*.fls
doc/**/*.fdb_latexmk
texput.log
# Slides live in their own repo (/Users/hc/builds/mll-slides); never commit them here.
doc/slides/
