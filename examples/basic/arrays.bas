10 REM arrays, strings, and math builtins
20 DIM A(10)
30 FOR I = 1 TO 10
40 A(I) = I * I
50 NEXT I
60 PRINT "SQUARES:"
70 FOR I = 1 TO 10
80 PRINT A(I);
90 NEXT I
100 PRINT
110 LET S$ = "MATA-LL"
120 PRINT "STRING: "; S$
130 PRINT "LENGTH: "; LEN(S$)
140 PRINT "LEFT 4: "; LEFT$(S$, 4)
150 PRINT "MID 3,2: "; MID$(S$, 3, 2)
160 PRINT "REVERSED: ";
170 FOR I = LEN(S$) TO 1 STEP -1
180 PRINT MID$(S$, I, 1);
190 NEXT I
200 PRINT
210 PRINT "CHR 65,66: "; CHR$(65) + CHR$(66)
220 PRINT "ASC OF A: "; ASC("A")
230 PRINT "INT 3.7="; INT(3.7); " ABS -4="; ABS(0 - 4); " SQR 144="; SQR(144)
240 END
